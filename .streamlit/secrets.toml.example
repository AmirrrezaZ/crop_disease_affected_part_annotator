# Copy to .streamlit/secrets.toml for local testing (gitignored), or paste
# the same two lines into this app's Settings -> Secrets on
# share.streamlit.io once deployed.

# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction" pooler variant, port 6543, for a serverless-style
# app like this rather than the direct connection).
DB_URL = "postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"

# Cloudflare R2: the bucket's public URL -- either the r2.dev subdomain
# (enable "Public access" on the bucket) or a custom domain you attached.
# No trailing slash.
R2_PUBLIC_BASE = "https://pub-xxxxxxxxxxxxxxxx.r2.dev"
