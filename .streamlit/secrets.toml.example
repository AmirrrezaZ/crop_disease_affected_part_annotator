# Copy to .streamlit/secrets.toml for local testing (gitignored), or paste
# the same two lines into this app's Settings -> Secrets on
# share.streamlit.io once deployed. Both come from the same Supabase project.

# Project Settings -> Database -> Connection string -> URI tab (use the
# "Transaction" pooler variant, port 6543, for a serverless-style app like
# this rather than the direct connection).
DB_URL = "postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"

# Storage -> your bucket -> make it Public, then this is
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
# No trailing slash.
IMAGE_PUBLIC_BASE = "https://xxxxxxxxxxxx.supabase.co/storage/v1/object/public/crop-disease-images"

# Optional: enables the "Ask GPT" buttons in Attributes mode. The key stays in
# secrets (never commit it). Without it, users can paste their own key in the sidebar.
# AVALAI_API_KEY = "sk-..."
# AVALAI_BASE_URL = "https://api.avalai.ir/v1"   # omit/replace for another OpenAI-compatible host
# GPT_MODEL = "gpt-5-mini"
# (alternatively OPENAI_API_KEY = "sk-..." for api.openai.com)
